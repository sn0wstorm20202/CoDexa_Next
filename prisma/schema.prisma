// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  memory   ConversationMemory?
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

model Message {
  id        String      @id @default(uuid())
  content   String
  role      MessageRole
  type      MessageType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fragment Fragment?
}

model Fragment {
  id         String   @id @default(uuid())
  messageId  String   @unique
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sandboxUrl String
  title      String
  files      Json
  
  // Full-stack architecture support
  architecture String @default("frontend") // "frontend" | "fullstack"
  backendUrl   String? // Backend API URL if full-stack
  dbType       String? // "sqlite" | "postgres" | null
  dbSchema     Json?   // Prisma schema as JSON
  seedData     Json?   // Initial seed data
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Conversation memory to maintain context between agent interactions
model ConversationMemory {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Context extracted from user messages
  lastContext String?  // Last meaningful context (e.g., "working on landing page")
  currentTask String?  // Current task context (e.g., "creating red landing page")
  domainInfo  Json?    // Domain-specific context (colors, layout preferences, etc.)
  
  // Recent conversation for context
  recentMessages Json? // Last 5-10 messages for context
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([projectId])
}
